*.pcapng
*.etl

# Lab, ML and experiment artefacts
lab/output/
lab/data/raw/
.venv/
__pycache__/
.ipynb_checkpoints/
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors
*.h5
mlruns/
wandb/

# Frontend (Tauri UI)
node_modules/
ui/dist/

# Editors and OS files
.idea/
.vscode/*
