{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Whereabouts contributors",
    "copyright": "Whereabouts contributors. Licensed under GPL-3.0-or-later.",
    "category": "Utility",
    "shortDescription": "See which app on your PC connects where, without reading what is sent.",
    "homepage": "https://github.com/Razni-Ahamed/Whereabouts",
    "licenseFile": "../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/whereabouts-service"
    ],
    "resources": {
      "../../data/easyprivacy.txt": "data/easyprivacy.txt",
      "../../data/companies.tsv": "data/companies.tsv",
      "../../data/dbip-country-lite.mmdb": "data/dbip-country-lite.mmdb",
      "../../data/dbip-asn-lite.mmdb": "data/dbip-asn-lite.mmdb",
      "../../data/README.md": "data/README.md",
      "../../data/SOURCES.generated.txt": "data/SOURCES.generated.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
